# Copy of the Vercel environment variable names this site expects.
# Real values live in Vercel (Project Settings > Environment Variables) and are pulled with `vercel env pull`.
# Never commit real values.

# Shown on the site (inlined into the client bundle)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Server-only
LEAD_INBOX_EMAIL=
CONTACT_PHONE=
RESEND_API_KEY=

# Sender shown on lead emails (must be on a verified Resend domain; onboarding@resend.dev until then)
LEAD_FROM_EMAIL=

# Public Vercel Blob URL of the resume PDF (printed by `pnpm sync-resume`)
RESUME_URL=
